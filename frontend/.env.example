# CropBazaar Frontend Environment Variables
# Copy this file to .env.local and populate with your Firebase Web App configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-cropbazaar-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-cropbazaar-project
VITE_FIREBASE_STORAGE_BUCKET=your-cropbazaar-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Custom Backend API Base URL (defaults to Vite proxy in development)
# VITE_API_BASE_URL=http://127.0.0.1:8000

