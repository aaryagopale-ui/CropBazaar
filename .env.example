DATABASE_URL=sqlite:///./cropbazaar.db
# Production: postgresql+psycopg://user:password@host/database
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Add the exact deployed Vercel origin to CORS_ORIGINS.
# Optional regex, scoped to YOUR project's preview deployments only:
# CORS_ORIGIN_REGEX=^https://cropbazaar-[a-z0-9-]+-YOUR-TEAM\.vercel\.app$
MARKET_DATA_MODE=demo
# Set mode=historical_csv with a normalized date,crop,mandi,price CSV.
HISTORY_CSV_PATH=
HISTORY_SOURCE=Operator-supplied historical CSV; freshness not verified
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VITE_API_URL=http://localhost:8000/api
