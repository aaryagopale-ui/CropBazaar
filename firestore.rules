rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /farmers/{userId} {
      // Authenticated farmers can only read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Creation requires authentication, matching document ID and matching uid field
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      // Updating requires authentication, matching document ID, and immutable uid
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      // Prevent accidental profile deletion
      allow delete: if false;
    }
  }
}

