# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: CORS allowed origins (comma-separated). Vercel (*.vercel.app) is automatically permitted.
# ALLOWED_ORIGINS=https://your-cropbazaar-frontend.vercel.app

# Optional: Custom dataset path (defaults to auto-discovering merged_mandi_weather.csv)
# DATASET_PATH=backend/data/merged_mandi_weather.csv

# Optional: Port configuration (set automatically by Render / hosting environments)
# PORT=8000
